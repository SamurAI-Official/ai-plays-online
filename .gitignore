.gradle/
build/
.kotlin/
.idea/
*.iml
.DS_Store
local.properties
# Runtime data (downloaded cores, saves, logs) lives in ~/.jev-plays-pokemon, but never commit ROMs or keys
*.nds
*.sav
.env

# Local test ROMs
roms/

# Emulator cores (downloaded at runtime; patched builds are rebuilt locally, never committed)
*.dylib
*.so
*.dll
*.zip

# JVM crash dumps (a core that crashed in native code leaves one behind: never a source file)
hs_err_pid*.log
replay_pid*.log

# Emulator/agent runtime artifacts that can land in the working tree
snapshots/
runs/
*.state
*.state[0-9]
*.srm
config.properties
